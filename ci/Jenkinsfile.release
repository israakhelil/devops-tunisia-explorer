// =====================================================================
// PIPELINE 3 : Build versionné (tag vX.Y.Z) avec archivage d'artefacts
// Déclencheur : création d'un tag Git de la forme v1.0.0
// Stages : Checkout > Validate Tag > Setup > Build > Run (Docker) > Smoke Test > Archive Artifacts
//          (+ nettoyage dans le bloc post)
// Différences : validation du format du tag, version injectée dans l'image,
//               le smoke test vérifie que la version de l'app = le tag,
//               l'image Docker est exportée et archivée.
// =====================================================================

def parallelPython(Closure body) {
  def branches = [:]
  ['3.11', '3.12'].each { v ->
    branches["Python ${v}"] = { body(v) }
  }
  parallel branches
}

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }

  environment {
    IMAGE = 'tunisia-explorer'
    TAG   = "${env.TAG_NAME}"                           // ex : v1.0.0
  }

  stages {

    stage('Checkout') {
      steps {
        script {
          def scmVars = checkout scm
          env.COMMIT = scmVars.GIT_COMMIT.take(7)
        }
        bat 'git log -1 --oneline'
      }
    }

    stage('Validate Tag') {
      steps {
        script {
          // Le tag doit avoir la forme vX.Y.Z (ex : v1.0.0)
          if (!(env.TAG_NAME ==~ /^v\d+\.\d+\.\d+$/)) {
            error("Tag invalide : '${env.TAG_NAME}' (format attendu : vX.Y.Z)")
          }
          echo "Tag valide : ${env.TAG_NAME}"
        }
      }
    }

    stage('Setup') {
      steps {
        bat 'docker version --format "Docker serveur : {{.Server.Version}}"'
        bat 'if exist reports rmdir /s /q reports'
        bat 'mkdir reports'
      }
    }

    stage('Build') {
      steps {
        script {
          parallelPython { v ->
            bat """
              docker build --build-arg PY_VERSION=${v} --build-arg APP_VERSION=${TAG} --build-arg GIT_COMMIT=${env.COMMIT} -t ${IMAGE}:${TAG}-py${v} . > reports\\build-py${v}.log 2>&1
              set RC=%ERRORLEVEL%
              type reports\\build-py${v}.log
              exit /b %RC%
            """
          }
        }
      }
    }

    stage('Run (Docker)') {
      steps {
        script {
          parallelPython { v ->
            bat "docker run -d --name api-${TAG}-py${v} ${IMAGE}:${TAG}-py${v}"
          }
        }
      }
    }

    stage('Smoke Test') {
      steps {
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
          script {
            parallelPython { v ->
              // EXPECTED_VERSION : le smoke test vérifie que /health renvoie bien la version du tag
              bat """
                docker exec -i -e EXPECTED_VERSION=${TAG} api-${TAG}-py${v} python - < scripts\\smoke_check.py > reports\\smoke-py${v}.txt 2>&1
                set RC=%ERRORLEVEL%
                if %RC%==0 (echo SMOKE: PASSED>> reports\\smoke-py${v}.txt) else (echo SMOKE: FAILED>> reports\\smoke-py${v}.txt)
                type reports\\smoke-py${v}.txt
                exit /b %RC%
              """
            }
          }
        }
      }
    }

    stage('Archive Artifacts') {
      steps {
        // Export de l'image finale (Python 3.12) : c'est la "livraison" de cette version
        bat "docker save -o reports\\${IMAGE}-${TAG}-py3.12.tar ${IMAGE}:${TAG}-py3.12"
        writeFile file: 'reports/pipeline-report.txt', text: """Pipeline    : ${env.JOB_NAME} #${env.BUILD_NUMBER}
Declencheur : tag ${env.TAG_NAME}
Commit      : ${env.COMMIT}
Version     : ${env.TAG_NAME}
Python      : 3.11 et 3.12 (en parallele)
Image       : ${IMAGE}-${TAG}-py3.12.tar (Python 3.12)
Smoke tests : voir smoke-py3.11.txt et smoke-py3.12.txt
"""
        archiveArtifacts artifacts: 'reports/**', fingerprint: true
      }
    }
  }

  post {
    always {
      script {
        parallelPython { v ->
          bat(script: "docker rm -f api-${TAG}-py${v}", returnStatus: true)
        }
      }
      bat(script: 'docker image prune -f', returnStatus: true)
    }
    success { echo "PIPELINE RELEASE ${env.TAG_NAME} : PASSED" }
    failure { echo "PIPELINE RELEASE ${env.TAG_NAME} : FAILED" }
  }
}
